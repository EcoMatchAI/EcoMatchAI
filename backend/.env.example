# Server
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ecomatch

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS - frontend origin (Vite dev server)
CLIENT_URL=http://localhost:5173

# Frontend base URL used to build email verification links
FRONTEND_URL=http://localhost:5173

# Email (Nodemailer SMTP). Leave SMTP_HOST blank to use the dev console transport
# (emails are not delivered; the link is printed to the server logs).
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EcoMatch <no-reply@ecomatch.ai>

# Resend cooldown for verification / change emails (seconds)
RESEND_COOLDOWN_SECONDS=60
